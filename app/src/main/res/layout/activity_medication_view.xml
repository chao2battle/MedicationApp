<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/med_white">

    <!-- Header -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="121dp"
        android:background="@color/med_blue"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="centerCrop"
        app:srcCompat="?attr/actionModeCloseDrawable"
        app:layout_constraintStart_toStartOf="@id/toolbar"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medication Name"
        android:textColor="@color/med_white"
        android:textSize="40sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/backButton"
        app:layout_constraintTop_toTopOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="@id/toolbar" />

    <!-- Medication Information -->
    <TextView
        android:id="@+id/medicationNameLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Medication Name:"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar" />

    <TextView
        android:id="@+id/medicationNameValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Medication name"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/medicationNameLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/medicationNameLabel"
        android:layout_marginEnd="24dp" />

    <TextView
        android:id="@+id/doseLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dose:"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/medicationNameLabel"
        app:layout_constraintTop_toBottomOf="@id/medicationNameValue" />

    <TextView
        android:id="@+id/doseValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Medication dose"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/doseLabel"
        app:layout_constraintTop_toBottomOf="@id/doseLabel" />

    <TextView
        android:id="@+id/amountLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Amount:"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/medicationNameLabel"
        app:layout_constraintTop_toBottomOf="@id/doseValue" />

    <TextView
        android:id="@+id/amountValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="Remaining amount"
        android:textColor="@android:color/black"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/amountLabel"
        app:layout_constraintTop_toBottomOf="@id/amountLabel" />

    <!-- Start Date -->
    <TextView
        android:id="@+id/startDateLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Date Started:"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/medicationNameLabel"
        app:layout_constraintTop_toBottomOf="@id/amountValue" />

    <EditText
        android:id="@+id/startDateInput"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:hint="MM/DD/YYYY"
        android:inputType="date"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/startDateLabel"
        app:layout_constraintTop_toBottomOf="@id/startDateLabel" />

    <!-- Pharmacy -->
    <TextView
        android:id="@+id/pharmacyLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pharmacy:"
        android:textColor="@android:color/black"
        android:textSize="24sp"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="@id/medicationNameLabel"
        app:layout_constraintTop_toBottomOf="@id/startDateInput" />

    <TextView
        android:id="@+id/pharmacyLink"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Pharmacy link"
        android:textColor="@color/med_blue"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/pharmacyLabel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/pharmacyLabel"
        android:layout_marginEnd="24dp" />

    <!-- Screen Actions -->
    <Button
        android:id="@+id/calendarButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calendar"
        android:backgroundTint="@color/med_blue"
        android:textColor="@color/med_white"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="@id/medicationNameLabel"
        app:layout_constraintTop_toBottomOf="@id/pharmacyLink" />

    <Button
        android:id="@+id/notesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Notes"
        android:backgroundTint="@color/med_blue"
        android:textColor="@color/med_white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/calendarButton"
        app:layout_constraintTop_toTopOf="@id/calendarButton"
        android:layout_marginStart="12dp" />

    <Button
        android:id="@+id/refillButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Refill"
        android:backgroundTint="@color/med_blue"
        android:textColor="@color/med_white"
        android:textSize="16sp"
        app:layout_constraintStart_toEndOf="@id/notesButton"
        app:layout_constraintTop_toTopOf="@id/calendarButton"
        android:layout_marginStart="12dp" />

    <!-- Bottom Navigation -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/bottomToolbar"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:background="@color/med_blue"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
